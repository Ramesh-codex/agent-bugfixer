# Copy to .env and fill in what you need. .env is gitignored -- never commit it.
# Unit tests and scripts/verify_zoo.py need none of these.

# --- Agent runs (python -m agent.run) ---
ANTHROPIC_API_KEY=
# Default: claude-haiku-5-5
AGENT_MODEL=
# Single mode. Defaults: 100000 tokens, 600 s
AGENT_TOKEN_BUDGET=
AGENT_WALL_CLOCK_TIMEOUT_S=
# Multi mode, shared by all roles. Defaults: 400000 tokens, 0.10 USD (estimated)
AGENT_MULTI_TOKEN_BUDGET=
AGENT_MULTI_COST_BUDGET_USD=

# --- Draft PRs (python -m agent.review pr <id>) ---
# Used only in the GitHub REST Authorization header; never passed to git.
GITHUB_TOKEN=
# owner/name
GITHUB_REPO=
# Local clone of GITHUB_REPO; push uses this clone's own credential helper.
TARGET_REPO_PATH=
# Default: main
GITHUB_BASE_BRANCH=
# Where the library lives inside the clone. Default: repo root
TARGET_REPO_SUBDIR=
